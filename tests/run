#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

python3 -m json.tool "$root/manifest.json" >/dev/null

if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$root"
fi

( cd "$root" && python3 -m unittest discover -s tests )
if command -v node >/dev/null 2>&1; then
  node "$root/tests/test_model.js"
  node "$root/tests/test_audio_flow.js"
else
  printf 'node not found: skipping Model.js unit tests\n'
fi

printf 'All portable plugin checks passed.\n'
